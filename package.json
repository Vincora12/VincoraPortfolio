    "verify:main-chat-enter": "node scripts/main-chat-enter-check.mjs",
    "verify:state-sync": "node scripts/state-sync-check.mjs",
    "verify:user-data-sync": "node scripts/user-data-sync-check.mjs",
    "verify:calendar": "node scripts/calendar-check.mjs",
    "verify:core-ingress": "node scripts/core-ingress-check.mjs",
