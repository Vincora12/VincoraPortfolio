    "build:mem0": "npm --prefix services/mem0 run build",
    "dev": "npm run build:server && node scripts/dev-server.mjs",
    "start": "node server-dist/server.mjs",
    "stop": "node scripts/service.mjs stop",
    "status": "node scripts/service.mjs status",
    "install:service": "node scripts/service.mjs install",
    "uninstall:service": "node scripts/service.mjs uninstall",
    "backup": "node scripts/backup.mjs",
    "test": "npm run verify:backend && npm run verify:projects && npm run verify:reminders && npm run verify:tool-runtime && npm run verify:agent-lab",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p netlify/functions/tsconfig.json",
