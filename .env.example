# REQUIRED
VINZMON_TOKEN=replace-with-a-random-secret-at-least-24-characters

# OPTIONAL — external model/services
VINZMON_SHORTCUT_TOKEN=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PORT=8787
VINZMON_DATA_DIR=
VINZMON_SCHEDULER_INTERVAL_MS=60000

# OPTIONAL — enable the local Mem0 OSS backend
VINZMON_MEMORY_WRITER_MODE=custom
VINZMON_MEMORY_SERVICE_SECRET=
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=gpt-5-mini
MEM0_LLM_API_KEY=
MEM0_LLM_BASE_URL=
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_MODEL=text-embedding-3-small
MEM0_EMBEDDER_API_KEY=
MEM0_EMBEDDER_BASE_URL=
MEM0_EMBEDDING_DIMS=1536

# OBSOLETE AFTER LOCAL MIGRATION
# URL, DEPLOY_URL, NETLIFY_BLOBS_CONTEXT, QDRANT_URL, QDRANT_API_KEY, RAILWAY_*
